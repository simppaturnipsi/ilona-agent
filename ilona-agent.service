[Unit]
Description=Ilona workstation inventory agent
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/ilona-agent/config.json

[Service]
Type=simple
ExecStart=%h/.local/bin/ilona-agent --config %h/.config/ilona-agent/config.json run
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/ilona-agent

[Install]
WantedBy=default.target
